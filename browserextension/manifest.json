{
  "manifest_version": 3,
  "name": "MathMate",
  "version": "1.2.1",
  "description": "Your personal AI study companion",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MathMate"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
